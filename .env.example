# Postgres connection string. On Vercel this is injected automatically when the
# Neon integration is connected. Use the pooled URL (host contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Secret used by Auth.js to encrypt session cookies. Generate with:
#   npx auth secret     (or)     openssl rand -base64 32
AUTH_SECRET=""

# Optional direct (non-pooled) URL used for migrations; Vercel sets it automatically.
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Only needed when not on Vercel and behind a proxy; Auth.js infers it otherwise.
# AUTH_URL="http://localhost:3000"

# Used by `npm run db:seed` to create the first admin account.
SEED_ADMIN_EMAIL="admin@nhimbe.local"
SEED_ADMIN_PASSWORD="change-me-please"
# Password for the three seeded developer accounts.
SEED_DEV_PASSWORD="nhimbe-dev-2026"
